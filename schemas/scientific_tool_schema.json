{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mardukasoka/harness2/schemas/scientific_tool_schema.json",
  "title": "ScientificToolRecord",
  "description": "A common envelope for one scientific tool call and its outcome. Exactly one of `result` or `error` must be present.",
  "type": "object",
  "required": ["schema_version", "call_id", "tool_name", "tool_version", "inputs", "execution_context", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "call_id": { "type": "string", "minLength": 1, "description": "Unique id of this call (e.g. trajectory node index or UUID)." },
    "tool_name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_.-]*$" },
    "tool_version": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "description": "Typed, named inputs. Order is preserved.",
      "items": { "$ref": "#/$defs/typed_value" }
    },
    "execution_context": { "$ref": "#/$defs/execution_context" },
    "status": { "type": "string", "enum": ["success", "error"] },
    "result": { "$ref": "#/$defs/result" },
    "error": { "$ref": "#/$defs/error" }
  },
  "oneOf": [
    { "properties": { "status": { "const": "success" } }, "required": ["result"], "not": { "required": ["error"] } },
    { "properties": { "status": { "const": "error" } }, "required": ["error"], "not": { "required": ["result"] } }
  ],
  "$defs": {
    "typed_value": {
      "type": "object",
      "required": ["name", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "array", "object", "file", "xml", "sequence"] },
        "value": {},
        "units": { "type": ["string", "null"], "description": "UCUM-style unit string, or null for dimensionless/not applicable." },
        "description": { "type": "string" }
      }
    },
    "execution_context": {
      "type": "object",
      "required": ["started_at", "backend"],
      "additionalProperties": false,
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_s": { "type": "number", "minimum": 0 },
        "backend": { "type": "string", "enum": ["local", "slurm", "ray", "container", "remote_api", "mock"] },
        "host": { "type": "string" },
        "environment": { "type": "string", "description": "Logical environment name, e.g. 'rosetta'." },
        "step_index": { "type": "integer", "minimum": 0 },
        "parent_call_id": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1, "description": "Upstream tool/package and version that produced the value." },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "description": "Evidence files or records backing the result. Must be non-empty.",
          "items": {
            "type": "object",
            "required": ["uri"],
            "additionalProperties": false,
            "properties": {
              "uri": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "role": { "type": "string" }
            }
          }
        },
        "command": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "required": ["value", "units", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "units": { "type": ["string", "null"] },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["validation_error", "resource_error", "runtime_error", "transport_error", "timeout", "unknown"] },
        "message": { "type": "string", "minLength": 1 },
        "traceback_summary": { "type": ["string", "null"], "maxLength": 4000 }
      }
    }
  }
}
